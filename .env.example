# Required: OpenRouter API key owned by the organization running this app.
OPENROUTER_API_KEY=

# Optional: default chat model for general OpenRouter text generation.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: model overrides for specific tasks.
OPENROUTER_PRIORITY_MODEL=openai/gpt-4o-mini
OPENROUTER_RECOMMENDATION_MODEL=openai/gpt-4o-mini
OPENROUTER_SIGNAL_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: metadata sent to OpenRouter.
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=SBDC Assessment
