# Required: OpenRouter API key owned by the organization running this app.
OPENROUTER_API_KEY=

# Optional: model used for all OpenRouter text generation.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: app identification headers sent to OpenRouter.
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=SBDC Assessment
